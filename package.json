{
  "name": "agent-teams-pixel",
  "description": "给 DeepSeek Harness Web 主窗口加「工作角色」页签 + 对话区像素人办公室浮层（The Agency en / agency-agents-zh 255+ 角色，29 预设团队）。一条命令安装，不改 dsh 源码。",
  "version": "0.2.7",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/team-engine.js",
    "lib/roles.json",
    "lib/roles-full.json",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "docs"
  ],
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "gen:roles": "node scripts/gen-roles.mjs",
    "test": "node --test",
    "check": "node -e \"require('node:child_process').execSync('node --check lib/index.js && node --check lib/team-engine.js && node --check src/client.main.js && node --check scripts/build-client.mjs', { stdio: 'inherit' })\" && node --test",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.2 <0.2.0 || >=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.2 <0.2.0 || >=0.2.0-rc.1 <0.3.0"
  },
  "devDependencies": {
    "semver": "^7.6.3"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "marketplace": {
      "profiles": [
        "web",
        "desktop"
      ],
      "requiresBuildApproval": false,
      "requiresRestart": true,
      "manualSteps": false
    },
    "permissions": {
      "level": "medium",
      "files": "read-write",
      "network": "none",
      "commands": [],
      "credentials": [],
      "externalServices": [],
      "notes": "只读写 ~/.dsh/agents-pixe/**（persist.json / custom-roles.json / teams/**）与包内只读数据 roles-full.json；模型调用一律经宿主 ctx.llm，自身不发外部网络请求；不启动子进程；只注册本机（loopback）HTTP 端点 /agents-pixe/*。"
    },
    "lifecycle": {
      "scripts": [],
      "details": {},
      "notes": "无 preinstall/install/postinstall hooks，无远程下载，无原生编译。client.js 随包发布（构建者本地 scripts/build-client.mjs 产出）。"
    },
    "compatibility": {
      "dsh": ">=0.1.0-rc.2 <0.3.0",
      "dshReleases": {
        "0.1.0-rc.7": "compatible",
        "0.1.1-rc.2": "compatible",
        "0.1.7-rc.2": "compatible",
        "0.2.0-rc.1": "compatible",
        "0.2.0-rc.2": "compatible"
      },
      "node": ">=22",
      "profiles": [
        "web",
        "desktop"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "agents-pixe",
    "pixel-office",
    "roles",
    "agency-agents"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EternalNight996/agent-teams-pixel.git"
  },
  "homepage": "https://github.com/EternalNight996/agent-teams-pixel",
  "engines": {
    "node": ">=22",
    "dsh": ">=0.1.0-rc.2 <0.3.0"
  }
}
