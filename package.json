{
  "name": "agent-teams-pixel",
  "version": "0.1.13-test",
  "description": "AgentTeams × Pixel Office: captain-led multi-agent collaboration driven by 508 role cards, with a live pixel office canvas showing each role's real state (idle / typing / walking / done / error). Tasks chain through roles by dependency; leader evaluates delivery and loops back if not satisfied.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets/agent-teams-pixel",
    "assets/readme",
    "cordis.patch.yml",
    "release-notes",
    "README.md",
    "README_ZH.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": {
    "name": "EternalNight996",
    "email": "eternal@example.com"
  },
  "homepage": "https://github.com/EternalNight996/agent-teams-pixel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EternalNight996/agent-teams-pixel.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent-teams",
    "pixel-office",
    "multi-agent",
    "subagent",
    "agency-agents",
    "roles"
  ],
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-chat"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.json && tsc -p tsconfig.client.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "node --test test/leader-loop.test.mjs test/pixel-mapping.test.mjs test/persistence.test.mjs test/e2e-demo.test.mjs test/pixel-routes.test.mjs test/captain-wiring.test.mjs test/presets-wiring.test.mjs test/session-integration.test.mjs test/dag-inbox.test.mjs test/shortcuts-settings.test.mjs test/resume-archive.test.mjs test/settings-section.test.mjs",
    "verify": "pnpm typecheck && pnpm test && pnpm build",
    "prepublishOnly": "pnpm verify"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
